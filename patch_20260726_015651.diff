+import React from 'react';
+
+/**
+ * Official Intervals.icu Waveform Logo Icon
+ * Equal left and right horizontal baselines (5.2px each), uniform stroke thickness, rounded joins.
+ */
+const IntervalsIcon = ({ size = 20, color = 'currentColor', className = '', style = {} }) => {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke={color}
+      strokeWidth="2.6"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      className={className}
+      style={{ display: 'inline-block', verticalAlign: 'middle', flexShrink: 0, ...style }}
+    >
+      <path d="M 0 12.5 H 5.2 L 8.6 7.0 L 12.0 18.0 L 15.4 3.6 L 18.8 12.5 H 24" />
+    </svg>
+  );
+};
+
+export default IntervalsIcon;
diff --git a/src/components/icons/StravaIcon.jsx b/src/components/icons/StravaIcon.jsx
new file mode 100644
index 0000000..457f408
--- /dev/null
+++ b/src/components/icons/StravaIcon.jsx
@@ -0,0 +1,28 @@
+import React from 'react';
+
+/**
+ * Perfect Geometric Strava Logo Icon
+ * 1. Upper chevron: symmetrical, slope ±1.5, thicker.
+ * 2. Lower chevron: symmetrical, slope ±1.5, slightly thinner.
+ * 3. Positioned exactly at the right-half width (starts exactly at upper's center apex).
+ * 4. Meets exactly flush on the y=12 baseline with a seamless overlap merge.
+ */
+const StravaIcon = ({ size = 20, color = '#fc4c02', className = '', style = {} }) => {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill={color}
+      className={className}
+      style={{ display: 'inline-block', verticalAlign: 'middle', flexShrink: 0, ...style }}
+    >
+      {/* Upper Chevron */}
+      <path d="M 9 3 L 3 12 H 6.6 L 9 8.4 L 11.4 12 H 15 Z" />
+      {/* Lower Chevron */}
+      <path d="M 9 12 L 15 21 L 21 12 H 18.2 L 15 16.8 L 11.8 12 Z" />
+    </svg>
+  );
+};
+
+export default StravaIcon;
